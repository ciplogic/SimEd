<UserControl x:Class="SimEd.Views.Documents.FileView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:documents="clr-namespace:SimEd.Views.Documents"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SimEd.ViewModels.Documents"
             d:DesignHeight="400"
             d:DesignWidth="300"
             x:CompileBindings="True"
             x:DataType="vm:FileViewModel"
             mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid
            x:Name="MainStatusBar"
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto">
            <StackPanel x:Name="OptionsContextMenu"
                        Grid.Column="0"
                        Orientation="Horizontal">
                <Menu>
                    <MenuItem Header="Tools" Background="DarkSlateGray">
                        <MenuItem
                            Background="BlueViolet"
                            Header="Show in Explorer"
                            Command="{Binding OnShowInExplorer}">
                        </MenuItem>
                        <MenuItem
                            Background="BlueViolet"
                            Header="Show Spaces"
                            Command="{Binding OnShowSpaces}">
                        </MenuItem>
                    </MenuItem>
                </Menu>
                <TextBlock
                    Margin="2"
                    VerticalAlignment="Center"
                    Text="{Binding Encoding}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <avaloniaEdit:TextEditor
            x:Name="MainTextEditor"
            Grid.Row="1"
            BorderThickness="0"
            FontFamily="{Binding SelectedFont}"
            FontWeight="Light"
            ShowLineNumbers="True"
            FontSize="{Binding FontSize}">

            <i:Interaction.Behaviors>
                <documents:DocumentTextBindingBehavior Text="{Binding Text, Mode=TwoWay}" />
            </i:Interaction.Behaviors>

            <avaloniaEdit:TextEditor.TextArea>
            </avaloniaEdit:TextEditor.TextArea>
        </avaloniaEdit:TextEditor>
    </Grid>
</UserControl>