<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:documents="clr-namespace:SimEd.ViewModels.Documents"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SimEd.Views.Documents.ImageFileView"
             x:DataType="documents:ImageFileViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal">
            <Button Command="{Binding OnOpen}">Open</Button>
        </StackPanel>
        <Image
            Grid.Row="1"
            Source="{Binding ImageFromPicture}"
            Width="{Binding Width}"
            Height="{Binding Height}" />
    </Grid>

</UserControl>