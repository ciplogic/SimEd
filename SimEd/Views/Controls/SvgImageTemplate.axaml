<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SimEd.Views.Controls">
    <Design.PreviewWith>
        <controls:SvgImageTemplate />
    </Design.PreviewWith>

    <Style Selector="controls|SvgImageTemplate">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <SvgImage Source="{DynamicResource PdbIcon}"></SvgImage>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
