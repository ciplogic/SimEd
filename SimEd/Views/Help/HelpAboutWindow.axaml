<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SimEd.Views.Help.HelpAboutWindow"
        Width="100"
        Height="100"
        WindowStartupLocation="CenterScreen"
        Title="HelpAboutWindow">

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="1">
            <TextBlock FontWeight="Bold">SimEd (Simple Editor) v 0.0.3</TextBlock>
            <TextBlock />
            <TextBlock>Brought to you by: </TextBlock>
            <TextBlock>Ciprian Khlud aka ciplogic (maintainer)</TextBlock>
            <TextBlock>Domas aka iDomas</TextBlock>
        </StackPanel>

        <Grid Grid.Row="2">
            <Button Click="OnClicked">Close</Button>
        </Grid>
    </Grid>
</Window>